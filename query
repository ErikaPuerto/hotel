-- 1. vista_reservas_clientes

CREATE VIEW vista_reservas_clientes AS
SELECT 
    r.id_reserva,
    c.usuario AS nombre_cliente,
    c.correo,
    h.numero AS numero_habitacion,
    th.nombre_tipo AS tipo_habitacion,
    sh.nombre AS sede_hotel,
    r.fecha_inicio,
    r.fecha_fin,
    r.estado AS estado_reserva
FROM Reserva r
JOIN Cliente c
    ON r.id_cliente = c.id_cliente
JOIN Habitacion h
    ON r.id_habitacion = h.id_habitacion
JOIN Tipo_Habitacion th
    ON h.id_tipo = th.id_tipo
JOIN Sede_Hotel sh
    ON h.id_sede = sh.id_sede;

-- =====================================================

-- 2. vista_pagos_reservas

CREATE VIEW vista_pagos_reservas AS
SELECT
    p.id_pago,
    c.usuario AS cliente,
    r.id_reserva,
    mp.tipo AS metodo_pago,
    p.monto,
    p.fecha,
    p.estado
FROM Pago p
JOIN Cliente c
    ON p.id_cliente = c.id_cliente
JOIN Reserva r
    ON p.id_reserva = r.id_reserva
JOIN MetodoPago mp
    ON p.id_metodo = mp.id_metodo;

-- =====================================================

-- 3. vista_habitaciones_disponibles

CREATE VIEW vista_habitaciones_disponibles AS
SELECT
    id_habitacion,
    numero,
    estado,
    id_tipo,
    id_sede
FROM Habitacion
WHERE estado = 'disponible'
WITH CHECK OPTION;

-- =====================================================

-- 4. vista_servicios_reserva

CREATE VIEW vista_servicios_reserva AS
SELECT
    rs.id,
    r.id_reserva,
    s.nombre AS servicio,
    rs.cantidad,
    s.costo,
    (rs.cantidad * s.costo) AS costo_total,
    rs.fecha_solicitud
FROM Reserva_Servicio rs
JOIN Reserva r
    ON rs.id_reserva = r.id_reserva
JOIN Servicio s
    ON rs.id_servicio = s.id_servicio;

-- =====================================================

-- 5. vista_tareas_empleados

CREATE VIEW vista_tareas_empleados AS
SELECT
    at.id_tarea,
    e.nombre AS empleado,
    toper.nombre AS operacion,
    h.numero AS habitacion,
    at.fecha,
    at.observaciones
FROM Asignacion_Tarea at
JOIN Empleado e
    ON at.id_empleado = e.id_empleado
JOIN Tipo_Operacion toper
    ON at.id_operacion = toper.id_operacion
LEFT JOIN Habitacion h
    ON at.id_habitacion = h.id_habitacion;

-- =====================================================
-- VISTAS DE REPORTE
-- =====================================================

-- 6. vista_ingresos_hotel

CREATE VIEW vista_ingresos_hotel AS
SELECT
    COUNT(p.id_pago) AS total_pagos,
    SUM(p.monto) AS ingresos_totales,
    AVG(p.monto) AS promedio_pago
FROM Pago p;

-- =====================================================

-- 7. vista_ocupacion_habitaciones

CREATE VIEW vista_ocupacion_habitaciones AS
SELECT
    h.numero AS habitacion,
    h.estado,
    COUNT(r.id_reserva) AS total_reservas
FROM Habitacion h
LEFT JOIN Reserva r
    ON h.id_habitacion = r.id_habitacion
GROUP BY h.numero, h.estado
ORDER BY total_reservas DESC;

-- =====================================================

-- 8. vista_servicios_mas_solicitados

CREATE VIEW vista_servicios_mas_solicitados AS
SELECT
    s.nombre AS servicio,
    COUNT(rs.id_servicio) AS veces_solicitado,
    SUM(rs.cantidad) AS total_solicitudes
FROM Servicio s
JOIN Reserva_Servicio rs
    ON s.id_servicio = rs.id_servicio
GROUP BY s.nombre
ORDER BY total_solicitudes DESC;

-- =====================================================

-- 9. vista_reservas_por_sede

CREATE VIEW vista_reservas_por_sede AS
SELECT
    sh.nombre AS sede,
    COUNT(r.id_reserva) AS total_reservas
FROM Reserva r
JOIN Habitacion h
    ON r.id_habitacion = h.id_habitacion
JOIN Sede_Hotel sh
    ON h.id_sede = sh.id_sede
GROUP BY sh.nombre
ORDER BY total_reservas DESC;

-- =====================================================

-- 10. vista_empleados_operaciones

CREATE VIEW vista_empleados_operaciones AS
SELECT
    e.nombre AS empleado,
    COUNT(at.id_tarea) AS total_operaciones
FROM Empleado e
LEFT JOIN Asignacion_Tarea at
    ON e.id_empleado = at.id_empleado
GROUP BY e.nombre
ORDER BY total_operaciones DESC;

-- =====================================================
-- VISTAS DE SEGURIDAD
-- =====================================================

-- 11. vista_clientes_segura

CREATE VIEW vista_clientes_segura AS
SELECT
    id_cliente,
    usuario,
    correo
FROM Cliente;

-- =====================================================

-- 12. vista_pagos_segura

CREATE VIEW vista_pagos_segura AS
SELECT
    p.id_pago,
    p.monto,
    p.fecha,
    p.estado,
    mp.tipo AS metodo_pago
FROM Pago p
JOIN MetodoPago mp
    ON p.id_metodo = mp.id_metodo;

-- =====================================================

-- 13. vista_empleados_segura

CREATE VIEW vista_empleados_segura AS
SELECT
    e.id_empleado,
    e.nombre,
    r.nombre_rol,
    sh.nombre AS sede
FROM Empleado e
JOIN Rol r
    ON e.id_rol = r.id_rol
JOIN Sede_Hotel sh
    ON e.id_sede = sh.id_sede;


CREATE VIEW vista_ingresos_tipo_habitacion AS
SELECT 
    th.nombre_tipo AS tipo_habitacion,
    COUNT(r.id_reserva) AS total_reservas,
    SUM(p.monto) AS ingresos_totales,
    AVG(p.monto) AS promedio_pago
FROM Pago p
JOIN Reserva r
    ON p.id_reserva = r.id_reserva
JOIN Habitacion h
    ON r.id_habitacion = h.id_habitacion
JOIN Tipo_Habitacion th
    ON h.id_tipo = th.id_tipo
GROUP BY th.nombre_tipo
ORDER BY ingresos_totales DESC;


CREATE VIEW vista_habitaciones_disponibles AS
SELECT 
    id_habitacion,
    numero,
    estado,
    id_tipo,
    id_sede
FROM Habitacion
WHERE estado = 'disponible'
WITH CHECK OPTION;

