CREATE TABLE Sede_Hotel (
    id_sede SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    direccion VARCHAR(100) NOT NULL,
    telefono VARCHAR(20) NOT NULL  -- corregido a VARCHAR
);

CREATE TABLE Rol (
    id_rol SERIAL PRIMARY KEY,
    nombre_rol VARCHAR(100) NOT NULL,       -- ej: Recepcionista, Ama de llaves, Gerente
    descripcion VARCHAR(255)                -- qué hace ese rol
);

CREATE TABLE Empleado (
    id_empleado SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    id_rol INT NOT NULL REFERENCES Rol(id_rol),        -- normalizado
    id_sede INT NOT NULL REFERENCES Sede_Hotel(id_sede)
);

CREATE TABLE Cliente (
    id_cliente SERIAL PRIMARY KEY,
    usuario VARCHAR(100) NOT NULL,
    documento VARCHAR(20) NOT NULL,         -- corregido a VARCHAR
    telefono VARCHAR(20) NOT NULL,          -- corregido a VARCHAR
    correo VARCHAR(100) NOT NULL
);

CREATE TABLE Tipo_Habitacion (
    id_tipo SERIAL PRIMARY KEY,
    nombre_tipo VARCHAR(100) NOT NULL,      -- ej: Simple, Doble, Suite
    precio_base INT NOT NULL,
    capacidad INT NOT NULL
);

CREATE TABLE Habitacion (
    id_habitacion SERIAL PRIMARY KEY,
    numero INT NOT NULL,
    estado VARCHAR(50) NOT NULL,            -- ej: Disponible, Ocupada, Mantenimiento
    id_tipo INT NOT NULL REFERENCES Tipo_Habitacion(id_tipo),
    id_sede INT NOT NULL REFERENCES Sede_Hotel(id_sede)
);

-- RESERVAS Y PAGOS

CREATE TABLE Reserva (
    id_reserva SERIAL PRIMARY KEY,
    fecha_inicio DATE NOT NULL,
    fecha_fin DATE NOT NULL,
    estado VARCHAR(50) NOT NULL,            -- ej: Pendiente, Confirmada, Cancelada
    id_cliente INT NOT NULL REFERENCES Cliente(id_cliente),
    id_habitacion INT NOT NULL REFERENCES Habitacion(id_habitacion),
    id_empleado INT REFERENCES Empleado(id_empleado)  -- empleado que gestionó la reserva
);

CREATE TABLE MetodoPago (
    id_metodo SERIAL PRIMARY KEY,
    tipo VARCHAR(100) NOT NULL              -- ej: Efectivo, Tarjeta, Transferencia
);

CREATE TABLE Pago (
    id_pago SERIAL PRIMARY KEY,
    monto INT NOT NULL,
    fecha DATE NOT NULL,
    estado VARCHAR(50) NOT NULL,            -- ej: Pagado, Pendiente, Reembolsado
    id_metodo INT NOT NULL REFERENCES MetodoPago(id_metodo),
    id_reserva INT NOT NULL REFERENCES Reserva(id_reserva),
    id_cliente INT NOT NULL REFERENCES Cliente(id_cliente)
);

-- SERVICIOS (catálogo independiente)

CREATE TABLE Servicio (
    id_servicio SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,           -- ej: Spa, Desayuno, Lavandería, Tour
    descripcion VARCHAR(255),
    costo INT NOT NULL
);

-- Relación muchos a muchos: una reserva puede tener varios servicios
CREATE TABLE Reserva_Servicio (
    id SERIAL PRIMARY KEY,
    id_reserva INT NOT NULL REFERENCES Reserva(id_reserva),
    id_servicio INT NOT NULL REFERENCES Servicio(id_servicio),
    cantidad INT DEFAULT 1,
    fecha_solicitud DATE
);

-- QUÉ HACEN LOS EMPLEADOS: operaciones/tareas registradas

CREATE TABLE Tipo_Operacion (
    id_operacion SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,           -- ej: Check-in, Check-out, Limpieza, Mantenimiento
    descripcion VARCHAR(255)
);

CREATE TABLE Asignacion_Tarea (
    id_tarea SERIAL PRIMARY KEY,
    id_empleado INT NOT NULL REFERENCES Empleado(id_empleado),
    id_operacion INT NOT NULL REFERENCES Tipo_Operacion(id_operacion),
    id_reserva INT REFERENCES Reserva(id_reserva),      -- opcional: tarea ligada a reserva
    id_habitacion INT REFERENCES Habitacion(id_habitacion), -- opcional: tarea ligada a habitación
    fecha DATE NOT NULL,
    observaciones VARCHAR(255)
);


